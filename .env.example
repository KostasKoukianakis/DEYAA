# Supabase Configuration
VITE_SUPABASE_URL=https://lzgchpvwviggeblicmjm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_67Uq8tcS9-8bOZqKFec56w_N6g_imcn

# Email Server Configuration (for sending emails to subscribers)
# For local development: http://localhost:5173
# For production: https://yourdomain.com
FRONTEND_URL=http://localhost:8080

# Email Server Port
EMAIL_SERVER_PORT=3001

# Email SMTP Configuration
# ⚠️ ΣΗΜΑΝΤΙΚΟ: Αυτά είναι για το EMAIL που ΣΤΕΛΝΕΙ τα verification emails (FROM)
# ΚΑΘΕ χρήστης που εγγράφεται θα λάβει email στο δικό του email address!
#
# Auto-detects provider based on EMAIL_USER domain (Gmail, Outlook, Yahoo, Zoho, etc.)
# Supported providers (auto-detected):
#   - Gmail (gmail.com) → smtp.gmail.com:587
#   - Outlook/Hotmail (outlook.com, hotmail.com, live.com) → smtp-mail.outlook.com:587
#   - Yahoo (yahoo.com, yahoo.gr) → smtp.mail.yahoo.com:587
#   - Zoho (zoho.com, zoho.eu) → smtp.zoho.eu:587
#
# Παράδειγμα:
#   EMAIL_USER=newsletter@deyaa.gr  (ή noreply@deyaa.gr)
#   EMAIL_PASS=app_password_here
#
#   Όταν κάποιος εγγραφεί με email: kostas@gmail.com
#   → Θα λάβει verification email στο kostas@gmail.com
#   → Αλλά το email θα στέλνεται από newsletter@deyaa.gr
#
# IMPORTANT: Use App-Specific Password, NOT your regular password!
#   Gmail: Enable 2FA → https://myaccount.google.com/apppasswords
#   Outlook: Use your password or App Password
EMAIL_USER=newsletter@deyaa.gr
EMAIL_PASS=your_app_password_here

# Optional: Override auto-detection (leave empty for auto-detection)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_SECURE=

# Frontend Environment Variable (for production)
# In production, set this to your email server URL
# VITE_EMAIL_API_URL=https://api.yourdomain.com/api/send-email

# ACCESSIBILITY (ΑΜΕΑ) – UserWay widget
# Same widget as greece20.gov.gr. Get your free account ID at https://userway.org/get/
# Leave empty to use the default shared account.
VITE_USERWAY_ACCOUNT_ID=

# Google Maps API Key (for location picker in problem reporting)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google reCAPTCHA — contact & problem-report forms
# Site key is public (frontend). Secret key is server-side only — never use VITE_ prefix.
# v3 = Score-based keys (default). v2 = «I'm not a robot» Checkbox keys only.
VITE_RECAPTCHA_VERSION=v3
VITE_RECAPTCHA_SITE_KEY=6Le17C8tAAAAABQFaJpJ98OBxdbwbdXo2rZcZ2Na
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Official DEYAA citizen services portal (Taxisnet, payments, meter readings)
VITE_DEYAA_SERVICES_PORTAL_URL=https://services.deyaa.gr/
