# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Email Server Configuration (for sending emails to subscribers)
# For local development: http://localhost:5173
# For production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Email Server Port
EMAIL_SERVER_PORT=3001

# Zoho SMTP Configuration
# For Europe data center, use smtp.zoho.eu
# For other regions, use smtp.zoho.com or smtp.zoho.in
EMAIL_HOST=smtp.zoho.eu
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@zoho.com
# IMPORTANT: Use a Zoho App-Specific Password, not your regular password!
# Create one at: https://accounts.zoho.eu/home#security/app-passwords
EMAIL_PASS=your_zoho_app_password_here

# Frontend Environment Variable (for production)
# In production, set this to your email server URL
# VITE_EMAIL_API_URL=https://api.yourdomain.com/api/send-email

# ACCESSIBILITY (ΑΜΕΑ) – UserWay widget
# Same widget as greece20.gov.gr. Get your free account ID at https://userway.org/get/
# Leave empty to use the default shared account.
VITE_USERWAY_ACCOUNT_ID=
